# Credenciais da Pluggy API
PLUGGY_CLIENT_ID=seu_client_id_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_aqui

# IDs dos items conectados (um por banco), separados por vírgula
# Obtenha em https://dashboard.pluggy.ai ou via POST /items
PLUGGY_ITEM_IDS=item_id_nubank,item_id_santander,item_id_inter

# Firebase
FIREBASE_WEBHOOK_URL=https://us-central1-SEU-PROJETO.cloudfunctions.net/etlWebhook
FIREBASE_ETL_SECRET=gere_uma_string_aleatoria_segura_aqui
FIREBASE_USER_UID=uid_do_seu_usuario_firebase

# Configuração opcional
DAYS_BACK=90    # Janela de transações em dias
MAX_TX=500      # Limite de transações enviadas por banco
